<Window x:Class="TemplateWithPreview.CreatePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ymmc="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
        mc:Ignorable="d"
        Title="テンプレートの登録" 
        Height="570" Width="470"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- DynamicAero2 の標準 ToggleButton を継承したトグルラッチ -->
        <Style x:Key="ToggleLatchStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- 1. 登録先テンプレートの切り替え（DynamicAero2 GroupBox） -->
                <GroupBox x:Name="GroupTargetTemplate" Header="登録先テンプレート" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <!-- 新規登録時: コンボボックスで切り替え -->
                        <ComboBox x:Name="ComboTargetTemplate" SelectionChanged="ComboTargetTemplate_SelectionChanged" 
                                  Padding="6,4" FontSize="12" Margin="0,2,0,0" />

                        <!-- パターン設定変更（編集）時: 対象テンプレート名のラベル表示 -->
                        <TextBlock x:Name="TextEditTargetName" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed" />

                        <!-- 新規登録時のみ表示される名前入力欄 -->
                        <StackPanel x:Name="PanelNewName" Margin="0,8,0,0">
                            <TextBlock Text="新規テンプレート名" FontSize="11" Opacity="0.8" Margin="0,0,0,3" />
                            <TextBox x:Name="TextPresetName" Padding="6,4" FontSize="12" />

                            <TextBlock Text="カテゴリ (カンマ区切りで複数設定可能)" FontSize="11" Opacity="0.8" Margin="0,6,0,3" />
                            <TextBox x:Name="TextCategory" Padding="6,4" FontSize="12" ToolTip="任意。空欄ならカテゴリなし" />
                            <WrapPanel x:Name="CategoryQuickButtons" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="タグ (カンマ区切り)" FontSize="11" Opacity="0.8" Margin="0,0,0,3" />
                            <TextBox x:Name="TextTags" Padding="6,4" FontSize="12" ToolTip="例: 感情, 赤系" />
                            <WrapPanel x:Name="TagQuickButtons" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- 既存テンプレートの別パターン追加時のステータス表示 -->
                        <TextBlock x:Name="TextPatternCountInfo" FontSize="11" Opacity="0.75" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </GroupBox>

                <!-- 2. パターン色設定 (色設定コントロール単体配置) -->
                <GroupBox Header="パターン色" Margin="0,0,0,12" Padding="10,8">
                    <StackPanel>
                        <!-- 複数アイテム選択時の自動抽出案内 -->
                        <TextBlock x:Name="TextMultiItemNotice" 
                                   Text="※選択中の複数アイテムから、文字色・装飾色・エフェクト色を自動抽出してパターン登録します" 
                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                        <!-- YMM4公式 ColorPicker コントロール本体 -->
                        <ymmc:ColorPicker x:Name="ColorPickerControl" Width="160" Height="28" HorizontalAlignment="Left" />
                        <TextBlock Text="色取得を開始するエフェクト (0:自動判定)" FontSize="11" Opacity="0.8" Margin="0,8,0,2" />
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="AutoColorStartEffectValue" Text="0" Width="30" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Right" />
                            <Slider x:Name="AutoColorStartEffectSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="0" ToolTip="0は文字色などから自動判定し、1〜10は指定した番号のエフェクトから順に色を取得します" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 3. 適応する項目の設定（DynamicAero2 GroupBox） -->
                <GroupBox Header="適応する項目" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <!-- 全選択 / 全解除 ボタン -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <Button Content="全選択" Click="SelectAll_Click" Padding="8,2" FontSize="10" Margin="0,0,4,0" />
                            <Button Content="全解除" Click="DeselectAll_Click" Padding="8,2" FontSize="10" />
                        </StackPanel>

                        <!-- エフェクト分類 -->
                        <TextBlock Text="エフェクト" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,2,0,2" />
                        <WrapPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <ToggleButton x:Name="LatchVideoEffects" Content="エフェクト一覧" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchFontColor" Content="文字色" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchStyle" Content="装飾・装飾色" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchFontStyles" Content="スタイル(太字/斜体/下線/打消)" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchCharDivision" Content="文字ごとに分割" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                        </WrapPanel>

                        <!-- フォント分類 -->
                        <TextBlock Text="フォント" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,2,0,2" />
                        <WrapPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <ToggleButton x:Name="LatchFontName" Content="フォント名" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                        </WrapPanel>

                        <!-- 位置分類 -->
                        <TextBlock Text="位置" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,2,0,2" />
                        <WrapPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <ToggleButton x:Name="LatchPosition" Content="位置 (X, Y, Z)" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                        </WrapPanel>

                        <!-- サイズ分類 -->
                        <TextBlock Text="サイズ" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,2,0,2" />
                        <WrapPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <ToggleButton x:Name="LatchFontSize" Content="フォントサイズ" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchZoom" Content="拡大率 (Zoom)" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                        </WrapPanel>

                        <!-- その他分類 -->
                        <TextBlock Text="その他" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,2,0,2" />
                        <WrapPanel Orientation="Horizontal" Margin="2,0,0,2">
                            <ToggleButton x:Name="LatchSpacing" Content="行間・文字間隔" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchBasePoint" Content="配置基準点" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchRotation" Content="回転" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchOpacity" Content="不透明度" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchBlend" Content="描画モード" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                            <ToggleButton x:Name="LatchFade" Content="フェード" IsChecked="True" Style="{StaticResource ToggleLatchStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. 下部アクションボタン -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource GroupBox.Static.OuterBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" IsCancel="True" Width="85" Padding="0,5" Margin="0,0,8,0" />
                <Button x:Name="ButtonSubmit" Content="登録" IsDefault="True" Width="85" Padding="0,5" FontWeight="Bold" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
