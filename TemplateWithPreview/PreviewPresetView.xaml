        <Style x:Key="HideApplyOptionsForTemplateStyle" TargetType="MenuItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsItemTemplate}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideTextApplyOptionsForFxStyle" TargetType="MenuItem" BasedOn="{StaticResource HideApplyOptionsForTemplateStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEffectPreset}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideApplySeparatorForTemplateStyle" TargetType="Separator">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsItemTemplate}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
