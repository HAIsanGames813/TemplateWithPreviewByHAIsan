        <!-- プリセットカード -->
        <Style x:Key="PresetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Button.MouseOver.Border}" />
                    <Setter Property="Background" Value="{DynamicResource Button.MouseOver.Background}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Button.Checked.Border}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Button.Checked.Border}" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryNonAudioCardStyle" TargetType="Border" BasedOn="{StaticResource PresetCardStyle}">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#55C878" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 控えめなタグバッジ -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
            <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1行目: プリセット種別タブと操作 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TabControl Grid.Column="0" SelectedIndex="{Binding PresetTabIndex}" SelectionChanged="PresetTabs_SelectionChanged" Width="214" Height="38" Margin="0,0,8,0"
                            Style="{DynamicResource {x:Type TabControl}}">
                    <TabItem ToolTip="テキストプリセット" Content="{x:Null}">
                        <TabItem.Header>
                            <Path Data="M18.5,4L19.66,8.35L18.7,8.61C18.25,7.74 17.79,6.87 17.26,6.43C16.73,6 16.11,6 15.5,6H13V16.5C13,17 13,17.5 13.33,17.75C13.67,18 14.33,18 15,18V19H9V18C9.67,18 10.33,18 10.67,17.75C11,17.5 11,17 11,16.5V6H8.5C7.89,6 7.27,6 6.74,6.43C6.21,6.87 5.75,7.74 5.3,8.61L4.34,8.35L5.5,4H18.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="17" Height="17" Stretch="Uniform" />
                        </TabItem.Header>
                    </TabItem>
                    <TabItem ToolTip="エフェクトプリセット（既存エフェクトに追加）" Content="{x:Null}">
                        <TabItem.Header>
                            <Path Data="M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="17" Height="17" Stretch="Uniform" />
                        </TabItem.Header>
                    </TabItem>
                    <TabItem ToolTip="アイテム全体を保存したテンプレート" Content="{x:Null}">
                        <TabItem.Header>
                            <Path Data="M18,22A2,2 0 0,0 20,20V4C20,2.89 19.1,2 18,2H12V9L9.5,7.5L7,9V2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="17" Height="17" Stretch="Uniform" />
                        </TabItem.Header>
                    </TabItem>
                    <TabItem ToolTip="素材ライブラリ" Content="{x:Null}">
                        <TabItem.Header>
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="17" Height="17" Stretch="Uniform" />
                        </TabItem.Header>
                    </TabItem>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Padding" Value="9,5" />
                            <Setter Property="MinWidth" Value="40" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="30" Height="26" Margin="2,0" Padding="3,2" Content=" " ContentTemplate="{StaticResource SearchIcon}" ToolTip="検索欄を表示／非表示" Click="SearchButton_Click" />
                <Button Width="30" Height="26" Margin="2,0" Padding="3,2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value=" " />
                            <Setter Property="ContentTemplate" Value="{StaticResource RefreshIcon}" />
                            <Setter Property="ToolTip" Value="プレビューを更新" />
                            <Setter Property="Command" Value="{Binding RefreshCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DeleteIcon}" />
                                    <Setter Property="ToolTip" Value="選択したプリセットを削除" />
                                    <Setter Property="Command" Value="{Binding DeleteSelectedPresetsCommand}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB">
                                    <Setter Property="ContentTemplate" Value="{StaticResource RefreshIcon}" />
                                    <Setter Property="ToolTip" Value="素材ライブラリを更新" />
                                    <Setter Property="Command" Value="{Binding RefreshCommand}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelectionMode}" Value="True" />
                                        <Condition Binding="{Binding SelectedPresetTab}" Value="LIB" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ContentTemplate" Value="{StaticResource DeleteIcon}" />
                                    <Setter Property="ToolTip" Value="選択した素材を削除" />
                                    <Setter Property="Command" Value="{Binding DeleteSelectedPresetsCommand}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="30" Height="26" Margin="2,0" Padding="3,2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value=" " />
                            <Setter Property="ContentTemplate" Value="{StaticResource AddIcon}" />
                            <Setter Property="ToolTip" Value="プリセットを登録" />
                            <Setter Property="Command" Value="{Binding CreatePresetCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ExportIcon}" />
                                    <Setter Property="ToolTip" Value="選択したプリセットをエクスポート" />
                                    <Setter Property="Command" Value="{Binding ExportSelectedPresetsCommand}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AddIcon}" />
                                    <Setter Property="ToolTip" Value="素材を追加" />
                                    <Setter Property="Command" Value="{Binding AddLibraryFilesCommand}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelectionMode}" Value="True" />
                                        <Condition Binding="{Binding SelectedPresetTab}" Value="LIB" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="ContentTemplate" Value="{StaticResource EditIcon}" />
                                    <Setter Property="ToolTip" Value="選択した素材のカテゴリ・タグを編集" />
                                    <Setter Property="Command" Value="{Binding EditSelectedLibraryAssetsCommand}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="30" Height="26" Margin="2,0" Padding="3,1" ToolTip="設定" Click="SettingsButton_Click">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform" />
                </Button>
                <Button Width="64" Height="26" Margin="2,0" Padding="5,2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="選択" />
                            <Setter Property="Command" Value="{Binding ToggleSelectionModeCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="Content" Value="完了" />
                                    <Setter Property="Command" Value="{Binding ToggleSelectionModeCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2行目: T用プレビュー文字列と適用対象 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tタブのみプレビュー文字列を表示 -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="FX">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="TPL">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="プレビュー (3文字まで):" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" Width="54" MaxLength="3"
                             VerticalAlignment="Center" Margin="0,0,6,0" Padding="4,2" />
                </StackPanel>

                <!-- 右側: 5つの適用対象トグルボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="FX">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="TPL">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="適用対象:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Opacity="0.75" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplyEffectIcon}"
                                  IsChecked="{Binding ApplyEffectsTarget}" 
                                  Margin="1,0" Padding="5,2" Width="30" Height="26"
                                  ToolTip="エフェクト一覧・文字色・装飾・装飾色・太字・イタリック・下線・打ち消し線・文字ごとに分割を適用" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplyFontIcon}"
                                  IsChecked="{Binding ApplyFontTarget}" 
                                  Margin="1,0" Padding="5,2" Width="30" Height="26"
                                  ToolTip="フォント名のみ適用" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplyPositionIcon}"
                                  IsChecked="{Binding ApplyPositionTarget}" 
                                  Margin="1,0" Padding="5,2" Width="30" Height="26"
                                  ToolTip="位置(X, Y, Z)を適用" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplySizeIcon}"
                                  IsChecked="{Binding ApplySizeTarget}" 
                                  Margin="1,0" Padding="5,2" Width="30" Height="26"
                                  ToolTip="フォントサイズ・拡大率を適用" />
                    <ToggleButton Content="その他" 
                                  IsChecked="{Binding ApplyOthersTarget}" 
                                  Margin="1,0" Padding="6,2" FontSize="11" 
                                  ToolTip="行間・文字間隔・配置基準点・回転・不透明度・描画モード・フェード等を適用" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="FX">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="FX適用:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Opacity="0.75" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplyEffectIcon}" IsChecked="{Binding ApplyEffectsTarget}" Margin="1,0" Padding="5,2" Width="30" Height="26" ToolTip="エフェクトを適用" />
                    <ToggleButton Content=" " ContentTemplate="{StaticResource ApplyPositionIcon}" IsChecked="{Binding ApplyPositionTarget}" Margin="1,0" Padding="5,2" Width="30" Height="26" ToolTip="位置を適用" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3行目: 検索とフィルター -->
        <Border x:Name="SearchPanel" Grid.Row="2" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="名前・カテゴリ・タグを検索" Padding="5,3" />
                <Button Grid.Column="1" Content="フィルター" Click="OpenFilter_Click" Margin="6,0,0,0" Padding="10,3" />
            </Grid>
        </Border>

        <!-- 4行目: カテゴリタブ。タブを右クリックしてカテゴリを追加・編集 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel>
                <TabControl ItemsSource="{Binding LibraryTypes}" SelectedItem="{Binding SelectedLibraryType, Mode=TwoWay}" Height="30" Margin="0,0,0,2">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></TabControl.ItemsPanel>
                    <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="10,2" /><Setter Property="MinWidth" Value="44" /></Style></TabControl.ItemContainerStyle>
                </TabControl>
            <ScrollViewer x:Name="CategoryTabsScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PreviewMouseWheel="CategoryTabs_PreviewMouseWheel">
                <TabControl x:Name="CategoryTabs" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                            PreviewMouseLeftButtonDown="CategoryTabs_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="CategoryTabs_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="CategoryTabs_PreviewMouseLeftButtonUp"
                            ToolTip="カテゴリタブをドラッグして並び替えできます"
                            Height="34">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Content" Value="{x:Null}" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="カテゴリを追加..." Command="{Binding Source={StaticResource Proxy}, Path=Data.AddCategoryCommand}" />
                                        <Separator />
                                        <MenuItem Header="カテゴリ名を変更..." Command="{Binding Source={StaticResource Proxy}, Path=Data.RenameCategoryCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="カテゴリを削除" Command="{Binding Source={StaticResource Proxy}, Path=Data.DeleteCategoryCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>
            </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 5行目: プリセットカード一覧 (スクロール可能) -->
        <Border Grid.Row="4" BorderThickness="2" Padding="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectionMode}" Value="True"><Setter Property="BorderBrush" Value="#55C878" /></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TextPresetItemViewModel}">
                        <Border Style="{StaticResource PresetCardStyle}"
                                Width="{Binding Source={StaticResource Proxy}, Path=Data.PresetCardWidth}"
                                AllowDrop="True"
                                Focusable="True" FocusVisualStyle="{x:Null}"
                                MouseEnter="Card_MouseEnter"
                                GotKeyboardFocus="Card_GotKeyboardFocus"
                                LostKeyboardFocus="Card_LostKeyboardFocus"
                                PreviewMouseWheel="Card_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="Card_PreviewMouseMove"
                                PreviewDragOver="Card_PreviewDragOver"
                                Drop="Card_Drop"
                                PreviewKeyDown="Card_PreviewKeyDown"
                                ToolTip="左クリック: 適用 / Shift+クリック: 並び替えモード&#x0a;右クリック: メニュー / Ctrl+ホイール: カラー切り替え / Deleteキー: 削除">
                            <!-- 右クリックメニュー -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="適用" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyCommand}" 
                                              CommandParameter="{Binding}" FontWeight="Bold" />
                                    <Separator />
                                    <MenuItem Header="パターンの設定変更..." 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.EditPatternCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="パターンの並び替え..."
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.OpenPatternOrderCommand}"
                                              CommandParameter="{Binding}"
                                              Visibility="{Binding HasMultiplePatterns, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="選択中アイテムでパターンを上書き" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.UpdatePatternFromSelectedCommand}" 
                                              CommandParameter="{Binding}" />
                                    <Separator Style="{StaticResource HideApplySeparatorForTemplateStyle}" />
                                    <MenuItem Header="エフェクトのみ適用" Style="{StaticResource HideApplyOptionsForTemplateStyle}"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyEffectOnlyCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="フォントのみ適用" Style="{StaticResource HideTextApplyOptionsForFxStyle}"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyFontOnlyCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="位置のみ適用" Style="{StaticResource HideApplyOptionsForTemplateStyle}"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyPositionOnlyCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="サイズのみ適用" Style="{StaticResource HideTextApplyOptionsForFxStyle}"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplySizeOnlyCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="その他のみ適用" Style="{StaticResource HideTextApplyOptionsForFxStyle}"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyOthersOnlyCommand}" 
                                              CommandParameter="{Binding}" />
                                    <Separator Style="{StaticResource HideApplySeparatorForTemplateStyle}" />
                                    <MenuItem Header="複製" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.DuplicateCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="プリセット設定" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.RenameCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="エクスポート" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ExportCommand}" 
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="現在のパターンを削除" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.DeletePatternCommand}" 
                                              CommandParameter="{Binding}"
                                              Visibility="{Binding HasMultiplePatterns, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="テンプレートを削除" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.DeleteCommand}" 
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <!-- 左クリックで適用 (右上のトグル状態に従う) -->
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" 
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ApplyCommand}" 
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding Source={StaticResource Proxy}, Path=Data.PresetPreviewHeight}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- プレビュー画像枠 -->
                                <Border Grid.Row="0" Background="{Binding Source={StaticResource Proxy}, Path=Data.PreviewBackgroundBrush}" CornerRadius="2,2,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <MediaElement Stretch="Uniform" IsMuted="False" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      Visibility="Collapsed" MediaEnded="CardPreviewVideo_MediaEnded"
                                                      MediaFailed="CardPreviewVideo_MediaFailed" />
                                        <TextBlock Text="描画中..." 
                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Opacity="0.5" FontSize="11" />

                                        <!-- サンプルカラードット (右上) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                Width="10" Height="10" CornerRadius="5"
                                                BorderBrush="#FFFFFF" BorderThickness="1"
                                                Background="{Binding ActiveSampleColorBrush}"
                                                ToolTip="{Binding ActivePattern.SampleColor}" />
                                    </Grid>
                                </Border>

                                <!-- カード情報欄 -->
                                <StackPanel Grid.Row="1" Margin="6,4,6,6">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={StaticResource Proxy}, Path=Data.IsSimpleView}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding PresetKindLabel}" FontSize="9" Opacity="0.85" ToolTip="プリセット種別" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding TagList}" Margin="0,2,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeStyle}" Margin="0,0,3,2">
                                                    <TextBlock Text="{Binding}" FontSize="9" Opacity="0.85" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 複数パターン登録時のカラードットリスト (数が増えたら自動的に2段・3段と展開) -->
                                    <ItemsControl ItemsSource="{Binding Patterns}" Margin="0,3,0,0"
                                                  Visibility="{Binding HasMultiplePatterns, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" MaxWidth="138" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PresetPatternItemViewModel}">
                                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,4,3"
                                                        Background="{Binding SampleColorBrush}"
                                                        BorderThickness="1" Cursor="Hand"
                                                        MouseLeftButtonDown="PatternDot_MouseLeftButtonDown"
                                                        ToolTip="{Binding SampleColorHex}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- テーマに調和する非アクティブ枠線 -->
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <!-- 選択中ドットはテーマの前景色でくっきり囲む -->
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowTextBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 控えめでシックなタグバッジ (5分類) -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding ShowEffectsBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="FX" FontSize="9" Opacity="0.8" ToolTip="エフェクト" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding HasFont, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="フォント" FontSize="9" Opacity="0.8" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="位置" FontSize="9" Opacity="0.8" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="サイズ" FontSize="9" Opacity="0.8" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding HasOthers, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="その他" FontSize="9" Opacity="0.8" ToolTip="行間・文字間隔・配置基準点・回転等" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Border>

        <Border Grid.Row="4" BorderThickness="2" Padding="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectionMode}" Value="True"><Setter Property="BorderBrush" Value="#55C878" /></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPresetTab}" Value="LIB"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
            <ItemsControl ItemsSource="{Binding VisibleAudioLibraryAssets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2,1,2,2" Padding="3" Background="{Binding Source={StaticResource Proxy}, Path=Data.PreviewBackgroundBrush}"
                                PreviewMouseLeftButtonDown="LibraryAsset_MouseLeftButtonDown" ToolTip="クリック: プレビュー / ダブルクリック: タイムラインに追加">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
                                    <Setter Property="BorderThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#55C878" />
                                        <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="個別音量を設定..." Click="LibrarySetVolume_Click" />
                                    <MenuItem Header="カテゴリを設定..." Click="LibrarySetCategory_Click" />
                                    <MenuItem Header="ライブラリから削除" Click="LibraryRemoveAsset_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid MinHeight="58" MaxHeight="76">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="9" Opacity="0.65" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource Button.Static.Border}" Margin="0,3" />
                                <Grid Grid.Row="2" Margin="0,2,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="28" Margin="0,0,8,0" Background="{Binding Source={StaticResource Proxy}, Path=Data.PreviewBackgroundBrush}" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="Fill" />
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                        <ymmc:TextBoxSlider Grid.Column="0" Grid.ColumnSpan="2" Width="190" HorizontalAlignment="Right"
                                                            Min="0" Max="400" DefaultMin="0" DefaultMax="100"
                                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Unit="%" IsUnitVisible="True" StringFormat="F1" Delta="0.1"
                                                            ToolTip="YMM4音量。初期範囲は0～100%、上限到達時は100→200→400%へ拡張" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding VisibleNonAudioLibraryAssets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                                <Border Style="{StaticResource LibraryNonAudioCardStyle}"
                                        Width="{Binding Source={StaticResource Proxy}, Path=Data.PresetCardWidth}"
                                        PreviewMouseLeftButtonDown="LibraryAsset_MouseLeftButtonDown"
                                ToolTip="クリック: プレビュー / ダブルクリック: タイムラインに追加">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="サムネイル位置を変更..." Click="LibrarySetThumbnailTime_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="動画">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="個別音量を設定..." Click="LibrarySetVolume_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="BGM"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="SE"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="動画"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="カテゴリを設定..." Click="LibrarySetCategory_Click" />
                                    <MenuItem Header="ライブラリから削除" Click="LibraryRemoveAsset_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding Source={StaticResource Proxy}, Path=Data.PresetPreviewHeight}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="{Binding Source={StaticResource Proxy}, Path=Data.PreviewBackgroundBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,4,4,4" Width="92" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="BGM"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="SE"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="音量 (%)" FontSize="10" />
                                    <Slider Minimum="0" Maximum="400" Value="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="0,2,0,2" />
                                    <CheckBox Content="既定値" IsChecked="{Binding UseDefaultVolume, UpdateSourceTrigger=PropertyChanged}" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,4,5,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="10" Opacity="0.7">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="TypeLabel" />
                                                <Binding Path="Category" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Border>

        <!-- 5行目: ステータスバー -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="0,1,0,0" Padding="8,3">
            <StackPanel>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Popup x:Name="LibraryPreviewPopup" PlacementTarget="{Binding ElementName=RootGrid}" Placement="RelativePoint"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Closed="LibraryPreviewPopup_Closed">
            <Border Width="480" Height="350" BorderBrush="{DynamicResource Button.Static.Border}" BorderThickness="1"
                    Background="{DynamicResource Button.Static.Background}" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="LibraryPopupImage" Grid.Row="0" Stretch="Uniform" />
                    <MediaElement x:Name="LibraryPopupMedia" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Stretch="Uniform" IsMuted="False" ScrubbingEnabled="True" Visibility="Collapsed"
                                  MediaOpened="LibraryPopupMedia_MediaOpened" MediaEnded="LibraryPopupMedia_MediaEnded"
                                  MediaFailed="LibraryPopupMedia_MediaFailed" />
                    <Grid Grid.Row="1" Margin="2,6,2,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibrarySeekTimeText" Grid.Column="0" Text="00:00 / 00:00" VerticalAlignment="Center" MinWidth="92" Margin="0,0,8,0" FontSize="11" Opacity="0.8" />
                        <Slider x:Name="LibrarySeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Visibility="Collapsed"
                                VerticalAlignment="Center" ValueChanged="LibrarySeekSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="LibrarySeekSlider_MouseDown" PreviewMouseLeftButtonUp="LibrarySeekSlider_MouseUp" />
                        <Button x:Name="LibraryPauseButton" Grid.Column="2" Content=" " Visibility="Collapsed"
                                ContentTemplate="{StaticResource StopIcon}" ToolTip="停止" Width="30" Height="26"
                                Margin="8,0,0,0" Padding="5,2" Click="LibraryPauseButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
